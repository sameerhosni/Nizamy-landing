{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:inbox-postgres": "vitest run --config vitest.inbox-integration.config.ts",
    "test:support-guards": "vitest run --config vitest.config.ts src/routes/support.test.ts",
    "test:inbox-sync": "vitest run --config vitest.config.ts src/routes/supportInbox.test.ts src/lib/supportInbox.test.ts",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "migrate": "node --enable-source-maps ./dist/migrate.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.3.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.2",
    "nodemailer": "^9.0.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pg": "^8.22.0",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "vitest": "^5.0.5"
  }
}
